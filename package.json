{
  "name": "ai-platform-sentinel",
  "version": "0.1.0",
  "description": "Autonomous post-deploy integration validation, root cause diagnostician, and self-healing test mesh.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "sentinel": "bin/sentinel.js"
  },
  "scripts": {
    "test": "node test/canary.test.js && node test/layout-check.test.js",
    "test:sync": "node test/cross-device-sync.test.js",
    "test:e2e": "playwright test",
    "doctor": "node bin/sentinel.js doctor",
    "layout": "node bin/sentinel.js layout oplox --env qa --report-only",
    "fleet": "node bin/sentinel.js fleet --env qa"
  },
  "keywords": [
    "testing",
    "sentinel",
    "diagnostics",
    "self-healing",
    "qa",
    "render",
    "oplox"
  ],
  "author": "Autonomous AI Data Squad",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
